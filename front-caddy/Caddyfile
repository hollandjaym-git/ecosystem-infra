# Shared front reverse-proxy for the whole alpinepost.app ecosystem.
# Owns 80/443, terminates TLS with one wildcard Cloudflare Origin cert, and
# routes each subdomain to that app's frontend nginx (by its unique `edge`
# alias). Each app's nginx already serves its SPA and proxies /api -> its
# backend, so this layer only does host-based routing + shared security headers.
#
# Certs: Cloudflare -> SSL/TLS -> Origin Server -> save origin.pem + origin.key
# into ./caddy/ (gitignored). SSL mode: Full (Strict).

*.alpinepost.app, alpinepost.app {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode gzip

	@app      host options.alpinepost.app
	@fitness  host fitness.alpinepost.app
	@peptides host peptides.alpinepost.app
	@gktw     host gktw.alpinepost.app

	# ---- options-journal (options.alpinepost.app, + legacy domain during transition) ----
	handle @app {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Cross-Origin-Opener-Policy "same-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Content-Security-Policy "default-src 'self'; script-src 'self' https://s3.tradingview.com https://*.tradingview.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.tradingview.com; connect-src 'self' https://*.tradingview.com wss://*.tradingview.com https://api.schwabapi.com; frame-src https://*.tradingview.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			-Server
		}
		# SSE streaming endpoint — no buffering. NOTE: it now flows front-caddy ->
		# oj-web (nginx) -> backend, so nginx must ALSO disable proxy_buffering for
		# /api/ai-suggestions (follow-up in options-journal/nginx.conf).
		reverse_proxy /api/ai-suggestions oj-web:80 {
			flush_interval -1
		}
		reverse_proxy oj-web:80
	}

	# ---- fitness-tracker ----
	handle @fitness {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}
		reverse_proxy fitness-web:80
	}

	# ---- peptides (self-contained; strict CSP from its own Caddyfile) ----
	handle @peptides {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Cross-Origin-Opener-Policy "same-origin"
			# camera=(self): copied from options-journal's block (which has no
			# camera use) without adjusting for peptides' actual barcode scanner —
			# was blocking camera use entirely on any browser that enforces it.
			Permissions-Policy "camera=(self), microphone=(), geolocation=()"
			# 'wasm-unsafe-eval': WebKit (Safari/iOS) enforces CSP on WebAssembly
			# compilation — without this, the barcode scanner's WASM decoder
			# (zxing) fails every call there, surfacing as a generic
			# "NotSupportedError" with no indication it's a CSP block.
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			-Server
		}
		reverse_proxy peptides-web:80
	}

	# ---- GKTW (gktw.alpinepost.app) — RESERVED, needs extraction (plan item #3) ----
	# GKTW currently lives as the /gktw PATH inside options-journal (its own
	# gktw.html entry + /assets/gktw-*.js + backend/gktw.js routes). Serving it at
	# this subdomain's ROOT cleanly requires extracting it so its shell + assets
	# live at "/", because a blanket rewrite to /gktw would also rewrite the asset
	# URLs and break them. Until that extraction lands, this subdomain 302s to the
	# existing path so the DNS/cert are exercised and the link works — but the PWA
	# still installs under the options origin, NOT its own space. Replace with a
	# real reverse_proxy to a dedicated gktw frontend once extracted.
	handle @gktw {
		redir https://options.alpinepost.app/gktw{uri}
	}

	# ---- apex -> options ----
	handle {
		redir https://options.alpinepost.app{uri}
	}
}

# ---- legacy domain (RETIRED 2026-08-15) — permanent 301 redirect to the new
# domain. Kept only to bounce old bookmarks/PWAs to options.alpinepost.app.
# Final teardown (this block + the sfoptionsdesk.* cert + the sfoptionsdesk
# Cloudflare DNS + Resend domain) can happen once users have migrated.
app.sfoptionsdesk.com {
	tls /etc/caddy/certs/sfoptionsdesk.pem /etc/caddy/certs/sfoptionsdesk.key
	redir https://options.alpinepost.app{uri} permanent
}
