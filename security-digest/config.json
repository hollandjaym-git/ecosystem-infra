    },
    "fitness": {
      "label": "Fitness",
      "url": "https://fitness.alpinepost.app",
      "env_file": "/home/deploy/fitness/.env",
      "containers": ["fitness-backend", "fitness-frontend"],
      "db": { "container": "pg-shared", "user": "digest_ro", "name": "fitness" },
      "users_table": "app_users",
      "auth_probe": "/api/webauthn/register/options",
      "expect_headers": ["strict-transport-security", "x-content-type-options", "content-security-policy"],
