# Copy to .env on the droplet (chmod 600). Everything here is optional:
#  - Telegram falls back to the bot + chat already configured in /home/deploy/peptides/.env.
#  - Without DIGEST_ANTHROPIC_API_KEY the digest still sends, just without the AI summary.
#  - Without GITHUB_TOKEN the "Code and dependencies" section says "not configured".
DIGEST_ANTHROPIC_API_KEY=
# Fine-grained personal access token, read-only, on the six repos: Metadata, Dependabot alerts, Pull requests, Actions.
GITHUB_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
